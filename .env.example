# ==========================================
# Portfolio Contact Form Email Configuration
# ==========================================
#
# Provider: Resend (https://resend.com)
#
# 1. RESEND_API_KEY:
#    Your API key from https://resend.com/api-keys
#    Example: re_123456789abcdef
RESEND_API_KEY=

# 2. CONTACT_FROM_EMAIL (Optional):
#    The sender address used for outgoing emails.
#    Before verifying a custom domain, Resend allows sending from onboarding@resend.dev
#    to your registered account email (Mennaali30617@gmail.com).
#    Once you verify a custom domain in Resend, you can configure your custom sender address, e.g.:
#    CONTACT_FROM_EMAIL="Menna Ali <contact@yourdomain.com>"
#    Default fallback if left empty: "Menna Ali Portfolio <onboarding@resend.dev>"
CONTACT_FROM_EMAIL="Menna Ali Portfolio <onboarding@resend.dev>"
